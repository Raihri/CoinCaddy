# Copy to .env and adjust. Never commit real secrets; this file holds placeholders only.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=smecopilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=smecopilot
POSTGRES_PORT=5433

# API (backend)
DATABASE_URL=postgresql+psycopg://smecopilot:change-me-local-only@127.0.0.1:5433/smecopilot
APP_ENV=development
API_CORS_ORIGINS=http://localhost:5173
MOCK_SERVICES_URL=http://127.0.0.1:8100
# Password given to every synthetic demo user by the seed script (local demo only)
DEMO_USER_PASSWORD=change-me-demo
DEMO_QUICK_LOGIN_ENABLED=false
# Key for the keyed hash that detects payee destination changes (the number itself is never stored)
DESTINATION_HASH_KEY=change-me-local-destination-key

# Mock bank/lender boundary (mock_services) - synthetic only, no live credentials
MOCK_SERVICES_PORT=8100

# Private storage for original uploaded files (never served). Empty = <repo>/storage/private
STORAGE_DIR=

# Finance Chat summary wording: template (default, no AI model) or claude (optional: pip install anthropic, set ANTHROPIC_API_KEY).
# Every number in an answer is calculated by the app either way; the model only drafts wording and gets no tools or record text.
FINANCE_CHAT_ASSISTANT=template
FINANCE_CHAT_MODEL=claude-opus-5-5
